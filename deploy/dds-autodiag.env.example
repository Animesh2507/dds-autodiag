# Copy to ~/.config/dds-autodiag.env and edit. Lines are KEY=value (no "export").
# ROS_DOMAIN_ID=0
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# AUTODIAG_PORT=8080
# Require a token for the dashboard (needed if you bind to a non-loopback address):
# AUTODIAG_UI_TOKEN=change-me-to-a-long-random-string
# AUTODIAG_ALLOWED_HOSTS=robot1.local,192.168.1.20
# Enable the remote collector endpoint for another AutoDiag to compare against:
# AUTODIAG_AGENT_TOKEN=change-me-too
